# Use Python 3.11 slim image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Install Python dependencies (requirements.txt is in /backend)
COPY ./requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the entire waste_management folder into /app
COPY ./waste_management /app/

# Verify structure
RUN ls -la /app/ && \
    test -f /app/manage.py || (echo "ERROR: manage.py not found in /app/" && exit 1)

# Collect static files
RUN python manage.py collectstatic --noinput || echo "Collectstatic will run after env vars are set"

# Expose port
EXPOSE 8000

# Run gunicorn from /app where manage.py is located
WORKDIR /app
CMD gunicorn waste_management.wsgi:application --bind 0.0.0.0:$PORT --workers 3 --timeout 120